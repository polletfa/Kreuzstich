{
  "name": "data-web",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsup src/index.ts",
    "start": "node dist/index.cjs",
    "test-watch": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "start:db:tests": "docker compose -f tests/docker-compose.yml up -d",
    "stop:db:tests": "docker compose -f tests/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg-promise": "^12.7.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "find-my-way": "^9.9.0",
    "esbuild": "^0.28.1"
  }
}
