{
  "name": "data-web",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsup src/index.ts",
    "start": "node dist/index.cjs",
    "test-watch": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "start:db:tests": "docker compose -f tests/docker-compose.yml up -d",
    "stop:db:tests": "docker compose -f tests/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "^10.2.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg-promise": "^12.7.1",
    "shared": "file:../shared-web"
  },
  "overrides": {
    "zod": "^4.6.7",
    "fast-uri": "^4.2.3"
  }
}
