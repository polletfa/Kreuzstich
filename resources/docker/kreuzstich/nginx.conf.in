user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  minimal  '[$time_local] "$host" "$request" $status $body_bytes_sent';

    access_log  /var/log/nginx/access.log minimal;
    error_log /var/log/nginx/error.log error;

    sendfile        on;

    keepalive_timeout  65;

    server {
        listen 80;

        root /usr/share/nginx/html;
        index index.html;

        # API backend
        location /api/ {
            proxy_pass http://kreuzstich-${ENVIRONMENT}-api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Block common scanning targets
        location ~ /\..+ {
            deny all;
            access_log off;
            log_not_found off;
        }
        location ~* \.(sql|bak|zip|tar|gz|rar|log|ini|conf)$ {
            deny all;
            access_log off;
            log_not_found off;
        }
        location ~* /(wp-admin|wp-login\.php|xmlrpc\.php|phpinfo\.php|info\.php|server-status) {
            deny all;
            access_log off;
            log_not_found off;
        }

        # Angular frontend
        location = /index.html {
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";   # never cache index.html
            expires off;
        }
        location ~* \.(js|css|wasm)$ {
            add_header Cache-Control "public, max-age=31536000, immutable";                                # cache hashed/versioned assets forever (actually for one year)
        }
        location ~* \.(jpg|jpeg|png|gif|ico|svg)$ {
            add_header Cache-Control "public, max-age=86400";                                              # cache static files for a day
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
